{
  "name": "clicked-photobooth",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names printer,web \"npm:print-agent\" \"next dev\"",
    "build": "next build",
    "start": "concurrently --kill-others-on-fail --names printer,web \"npm:print-agent\" \"next start\"",
    "dev:web": "next dev",
    "start:web": "next start",
    "lint": "eslint .",
    "print-agent": "node print-agent/server.mjs",
    "test": "node --test print-agent/*.test.mjs"
  },
  "dependencies": {
    "@eslint/eslintrc": "latest",
    "concurrently": "latest",
    "cors": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "express": "latest",
    "lucide-react": "^1.33.0",
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest"
  }
}

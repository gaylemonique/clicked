NEXT_PUBLIC_PRINT_AGENT_URL=http://localhost:3421/print
PRINT_AGENT_PORT=3421
PRINT_JOB_DIRECTORY=print-agent/jobs

# Point this at the command supplied by the installed JK-5802H Windows driver.
# {file} is replaced with the generated 384-dot PNG path.
# JK5802_PRINT_COMMAND=C:\Path\To\printer-cli.exe
# JK5802_PRINT_ARGS=["--printer","JK-5802H","--file","{file}"]
